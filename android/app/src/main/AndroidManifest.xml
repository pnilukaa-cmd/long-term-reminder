<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ runtime permission for posting notifications at all
         (REQ-11.1 / task brief item 6). `flutter_local_notifications` and
         `permission_handler` both auto-merge this into the manifest on
         their own, but declaring it explicitly here documents the
         dependency rather than leaving it implicit in a third-party
         package's own manifest. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Lets the boot receivers below (and `workmanager`'s own
         reboot-persistence, per the scheduling ADR §2) actually run —
         without this, `BOOT_COMPLETED` is never delivered to the app at
         all. Task brief item 3. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- `workmanager`'s periodic reconciliation task (task brief item 2)
         needs to briefly hold a wake lock to run its work reliably when
         the device would otherwise be asleep. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- Not declared here on purpose: `com.android.vending.BILLING`, needed
         for the paywall (this slice) — `in_app_purchase_android` (the
         Android implementation the official `in_app_purchase` plugin pulls
         in) declares and auto-merges this into the final manifest on its
         own, the same way `flutter_local_notifications`/`permission_handler`
         auto-merge `POST_NOTIFICATIONS` above. Documented here, not
         declared, so it isn't silently forgotten as a possible first-build
         gap if that auto-merge ever doesn't happen as expected —
         unverified, since nothing in this project has actually been built. -->
    <application
        android:label="long_term_reminder"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />

        <!-- Task brief item 3 ("a boot receiver so a reboot triggers
             rescheduling"). `flutter_local_notifications`' own documented
             boot-survival mechanism: on BOOT_COMPLETED, the plugin
             re-registers every notification it previously scheduled via
             `zonedSchedule`, using its own internal persisted record (kept
             independently of this app's `scheduled_notifications` table).
             This is a real, complementary mechanism to `workmanager`'s
             own reboot-persistence (used for the periodic reconciliation
             task, registered separately — see
             `workmanager_dispatcher.dart`'s doc comment on why the two
             aren't redundant): this receiver re-arms individual alarms
             immediately on boot, rather than waiting for the next
             (up-to-24h-away) periodic reconciliation window or the user
             next opening the app.

             UNVERIFIED: the exact receiver class names below are
             transcribed from `flutter_local_notifications`' documented
             AndroidManifest setup instructions for its Android 13/14+
             plugin generation, not confirmed against the actual installed
             package version in this environment (no SDK/pub.dev access
             here — see pubspec.yaml's caveat on this package). If the
             installed version's class names differ, this is a likely
             first-build failure — check
             `flutter_local_notifications`' current README for the
             exact manifest snippet it expects before relying on this. -->
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <receiver android:exported="false" android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver"/>
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
